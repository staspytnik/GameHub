<article class="game-card" data-id="{{id}}">
  <img class="game-card__image" src="{{image}}" alt="{{name}}" />
  <div class="game-card__body">
    <h3 class="game-card__title">{{name}}</h3>
    <p class="game-card__genre">{{genre}}</p>
    <p class="game-card__meta">
      <span class="game-card__rating">{{rating}}</span>
      <span class="game-card__released">{{released}}</span>
    </p>
  </div>
</article>
