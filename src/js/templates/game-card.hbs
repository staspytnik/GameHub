<article class="game-card" data-id="{{id}}">
  <div class="game-card__header">
    <img class="game-card__image" src="{{background_image}}" alt="{{name}}" />
    <button class="game-card__likeBtn">
      <svg class="game-card__like" width="12" height="12" viewBox="0 0 16 14" fill="none"
        xmlns="http://www.w3.org/2000/svg">
        <path
          d="M13.5275 1.7413C13.187 1.40063 12.7827 1.1304 12.3378 0.946021C11.8928 0.761646 11.4158 0.666748 10.9342 0.666748C10.4525 0.666748 9.97559 0.761646 9.53061 0.946021C9.08564 1.1304 8.68135 1.40063 8.34085 1.7413L7.63418 2.44797L6.92752 1.7413C6.23972 1.0535 5.30687 0.667105 4.33418 0.667105C3.3615 0.667105 2.42865 1.0535 1.74085 1.7413C1.05306 2.42909 0.666657 3.36194 0.666656 4.33463C0.666656 5.30732 1.05306 6.24017 1.74085 6.92797L2.44752 7.63463L7.63418 12.8213L12.8209 7.63463L13.5275 6.92797C13.8682 6.58746 14.1384 6.18317 14.3228 5.7382C14.5072 5.29323 14.6021 4.81629 14.6021 4.33463C14.6021 3.85297 14.5072 3.37603 14.3228 2.93106C14.1384 2.48609 13.8682 2.0818 13.5275 1.7413Z"
          stroke="white" stroke-width="1.33333" />
      </svg>
    </button>
    <div class="game-card__overflow">
      <ul class="game-card__platforms">
        {{#each platforms}}
        <li class="game-card__platform">{{this.platform.name}}</li>
        {{/each}}
      </ul>
    </div>
  </div>
  <div class="game-card__body">
    <h3 class="game-card__title">{{name}}</h3>
    <div class="game-card__description">
      <ul class="game-card__genre">
        {{#each genres}}
        <li>{{this.name}}</li>
        {{/each}}
      </ul>
      <p class=" game-card__meta">
        <span class="game-card__released">
          {{released}}
        </span>
        <span class="game-card__rating">
          <svg width="10" height="10" viewBox="0 0 11 10" fill="none" xmlns="http://www.w3.org/2000/svg">
  <path d="M4.5378 0.483525C4.7478 -0.161175 5.6599 -0.161175 5.8692 0.483525L6.6182 2.78792C6.66396 2.92827 6.75291 3.05055 6.87235 3.1373C6.99178 3.22405 7.13558 3.27082 7.2832 3.27092H9.7066C10.3849 3.27092 10.6663 4.13892 10.1182 4.53792L8.1582 5.96172C8.03852 6.04855 7.9494 6.17103 7.90363 6.31162C7.85786 6.45221 7.85778 6.60368 7.9034 6.74432L8.6524 9.04872C8.8624 9.69342 8.1239 10.2303 7.5744 9.83132L5.6144 8.40752C5.49484 8.32073 5.35089 8.27398 5.20315 8.27398C5.05541 8.27398 4.91145 8.32073 4.7919 8.40752L2.8319 9.83132C2.2831 10.2303 1.5453 9.69342 1.7546 9.04872L2.5036 6.74432C2.54922 6.60368 2.54914 6.45221 2.50336 6.31162C2.45759 6.17103 2.36848 6.04855 2.2488 5.96172L0.289497 4.53862C-0.258602 4.13962 0.0234976 3.27162 0.701098 3.27162H3.1238C3.27153 3.27166 3.41549 3.22496 3.53506 3.1382C3.65464 3.05145 3.7437 2.92908 3.7895 2.78862L4.5378 0.483525Z" fill="#FFBA00" />
</svg>
          {{rating}}
        </span>
    </div>
    </p>
  </div>
</article>